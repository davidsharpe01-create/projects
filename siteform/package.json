{
  "name": "siteform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.tsx --bundle --minify --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=public/app.js",
    "test": "node --test --test-isolation=none",
    "preview": "python3 -m http.server 4173 --bind 0.0.0.0 --directory public"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "esbuild": "0.27.4"
  }
}
